<Project>
    <PropertyGroup>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <Deterministic>true</Deterministic>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- The SDK derives AnalysisLevel and WarningLevel from the TFM major, so a net11.0 leg
             would get 11.0 / 11 while every other leg stays at 10. Combined with .globalconfig's
             `dotnet_analyzer_diagnostic.severity = error` baseline and TreatWarningsAsErrors, that
             silently turns every rule and warning wave newly enabled in .NET 11 into a build error
             on one TFM only. Pin both so every TFM sees the same rule set and raising it is an
             explicit, reviewable change. -->
        <AnalysisLevel>10.0</AnalysisLevel>
        <WarningLevel>10</WarningLevel>
    </PropertyGroup>

    <PropertyGroup Condition="'$(CI)' == 'true' Or '$(TF_BUILD)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

        <!-- Without this, a plain `dotnet restore` silently rewrites a stale lock file instead of
             failing, so CI can go green against a lock that does not match the csproj. -->
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>

    <!-- The SDK discovers .globalconfig by walking every directory above each source file. A git
         worktree placed inside the repo (.claude/worktrees/<name>) therefore picks up the outer
         checkout's .globalconfig as well as its own. Keys duplicated across global configs are
         treated as conflicting and dropped, which silently un-suppresses every rule configured
         there. Pin discovery to the .globalconfig beside this file instead. -->
    <PropertyGroup>
        <DiscoverGlobalAnalyzerConfigFiles>false</DiscoverGlobalAnalyzerConfigFiles>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory).globalconfig')">
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory).globalconfig" />
        <EditorConfigFiles Include="$(MSBuildThisFileDirectory).globalconfig" />
    </ItemGroup>

    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CA1707;CA2012;MA0042;S6966;S2068;S5445;EPC29</NoWarn>

        <!-- Verify maintenance fee: open source, non-revenue exemption. Time-bounded (max 12 months) — renew before it lapses. -->
        <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
        <Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
    </PropertyGroup>
</Project>
